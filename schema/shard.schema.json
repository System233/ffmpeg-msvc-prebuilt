{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FFmpeg release catalog shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releases",
    "lts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2099
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    },
    "lts": {
      "type": "boolean",
      "description": "Explicit long-term-support release-family classification. Not an active support guarantee."
    }
  },
  "oneOf": [
    {
      "required": [
        "version"
      ],
      "not": {
        "required": [
          "year"
        ]
      },
      "properties": {
        "releases": {
          "items": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "version"
                  ]
                },
                {
                  "required": [
                    "commit"
                  ]
                },
                {
                  "required": [
                    "ref"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "required": [
        "year"
      ],
      "not": {
        "required": [
          "version"
        ]
      },
      "properties": {
        "releases": {
          "items": {
            "required": [
              "version"
            ]
          }
        },
        "lts": {
          "const": false
        }
      }
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "file",
        "size",
        "sha256",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.+\\-]+\\.zip$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/\\s?#@]+/[^\\s#]+$",
          "description": "Absolute public download URL for this release asset."
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "binary"
      ],
      "additionalProperties": false,
      "properties": {
        "abi": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": 2
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "binary": {
          "$ref": "#/$defs/asset"
        },
        "develop": {
          "$ref": "#/$defs/asset"
        },
        "debug": {
          "$ref": "#/$defs/asset"
        },
        "note": {
          "const": "legacy-lgpl-licensing",
          "description": "Historical LGPL licensing notice; localized explanation and update-history link."
        }
      },
      "dependentRequired": {
        "abi": [
          "format"
        ],
        "format": [
          "abi"
        ],
        "date": [
          "abi"
        ]
      },
      "allOf": [
        {
          "not": {
            "required": [
              "develop",
              "debug"
            ]
          }
        },
        {
          "if": {
            "required": [
              "debug"
            ]
          },
          "then": {
            "required": [
              "abi",
              "format"
            ]
          }
        },
        {
          "if": {
            "required": [
              "abi"
            ]
          },
          "then": {
            "not": {
              "required": [
                "develop"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "note"
            ]
          },
          "then": {
            "not": {
              "required": [
                "abi"
              ]
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "required": [
        "tag",
        "date",
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^ffmpeg-[A-Za-z0-9.+_-]+$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(x64|x86|arm|arm64)-windows-(static|shared)-(lgpl|gpl|nonfree)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    }
  }
}
