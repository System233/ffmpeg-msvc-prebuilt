# Run the actual production dependency pipeline, without invoking vcpkg or FFmpeg.
# Usage: cmake -DCURRENT_PACKAGES_DIR=<package> -DCURRENT_INSTALLED_DIR=<installed>
#        -DPKGCONF=<host pkgconf> -DOUTPUT_DIR=<temporary directory> -P tests/test_ffmpeg_deps.cmake
cmake_minimum_required(VERSION 3.21)
foreach(var CURRENT_PACKAGES_DIR CURRENT_INSTALLED_DIR PKGCONF OUTPUT_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "Missing ${var}")
    endif()
endforeach()
set(VCPKG_TARGET_IS_WINDOWS TRUE)
if(CMAKE_HOST_WIN32)
    set(VCPKG_HOST_PATH_SEPARATOR ";")
else()
    set(VCPKG_HOST_PATH_SEPARATOR ":")
endif()
if(NOT DEFINED FFMPEG_PKGCONFIG_MODULES)
    set(FFMPEG_PKGCONFIG_MODULES libavutil)
endif()
if(NOT DEFINED FFMPEG_VERSION)
    set(FFMPEG_VERSION "4.4.8")
endif()
if(NOT DEFINED VCPKG_LIBRARY_LINKAGE)
    set(VCPKG_LIBRARY_LINKAGE static)
endif()
# Script-mode metadata tests do not initialize the compiler environment.
# Model the toolchain inventory explicitly; native links still use real MSVC.
if(NOT DEFINED ENV{LIB} OR "$ENV{LIB}" STREQUAL "")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/fixture-toolchain")
    file(WRITE "${OUTPUT_DIR}/fixture-toolchain/ws2_32.lib" "")
    set(ENV{LIB} "${OUTPUT_DIR}/fixture-toolchain")
endif()
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_root}/scripts/cmake/ffmpeg-portfile.cmake" _recipe)
# Reusing a previously built package may predate shared metadata
# normalization. Exercise the actual production block on the scratch copy.
if(FFBUILD_TEST_NORMALIZE_SHARED)
    string(FIND "${_recipe}" "# BEGIN native pkg-config path normalization" _path_start)
    string(FIND "${_recipe}" "# END native pkg-config path normalization" _path_end)
    math(EXPR _path_length "${_path_end}-${_path_start}")
    string(SUBSTRING "${_recipe}" ${_path_start} ${_path_length} _path_normalize)
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")
    file(WRITE "${OUTPUT_DIR}/production-path-normalize.cmake" "${_path_normalize}")
    include("${OUTPUT_DIR}/production-path-normalize.cmake")
    file(REMOVE "${OUTPUT_DIR}/production-path-normalize.cmake")
    string(FIND "${_recipe}" "# BEGIN shared pkg-config normalization" _normalize_start)
    string(FIND "${_recipe}" "# END shared pkg-config normalization" _normalize_end)
    if(_normalize_start LESS 0 OR _normalize_end LESS _normalize_start)
        message(FATAL_ERROR "Production shared normalization block missing")
    endif()
    math(EXPR _normalize_length "${_normalize_end}-${_normalize_start}")
    string(SUBSTRING "${_recipe}" ${_normalize_start} ${_normalize_length} _normalize)
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")
    file(WRITE "${OUTPUT_DIR}/production-normalize.cmake" "${_normalize}")
    include("${OUTPUT_DIR}/production-normalize.cmake")
    file(REMOVE "${OUTPUT_DIR}/production-normalize.cmake")
endif()
string(FIND "${_recipe}" "# BEGIN module dependency metadata" _start)
string(FIND "${_recipe}" "# END module dependency metadata" _end)
if(_start LESS 0 OR _end LESS _start)
    message(FATAL_ERROR "Production dependency block missing")
endif()
math(EXPR _length "${_end}-${_start}")
string(SUBSTRING "${_recipe}" ${_start} ${_length} _block)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/production-deps.cmake" "${_block}")
include("${OUTPUT_DIR}/production-deps.cmake")
file(REMOVE "${OUTPUT_DIR}/production-deps.cmake")
include("${_root}/scripts/cmake/package-config.cmake")
ffmpeg_install_cmake_package("${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/modules.txt" "${FFMPEG_MODULES}")
if(EXISTS "${OUTPUT_DIR}/fixture-toolchain")
    file(REMOVE_RECURSE "${OUTPUT_DIR}/fixture-toolchain")
endif()
