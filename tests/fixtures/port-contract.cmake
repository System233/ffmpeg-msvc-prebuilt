function(vcpkg_copy_pdbs)
    file(APPEND "${FIXTURE}/helpers.txt" "copy-pdbs\n")
endfunction()
function(vcpkg_copy_tools)
    cmake_parse_arguments(PARSE_ARGV 0 arg "AUTO_CLEAN" "DESTINATION" "TOOL_NAMES")
    file(APPEND "${FIXTURE}/helpers.txt" "copy-tools:${arg_TOOL_NAMES}\n")
    file(MAKE_DIRECTORY "${arg_DESTINATION}")
    foreach(tool IN LISTS arg_TOOL_NAMES)
        file(COPY_FILE "${CURRENT_PACKAGES_DIR}/bin/${tool}.exe" "${arg_DESTINATION}/${tool}.exe")
        if(arg_AUTO_CLEAN)
            file(REMOVE "${CURRENT_PACKAGES_DIR}/bin/${tool}.exe" "${CURRENT_PACKAGES_DIR}/debug/bin/${tool}.exe")
        endif()
    endforeach()
endfunction()
function(vcpkg_install_copyright)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "" "FILE_LIST")
    file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/share/ffmpeg")
    foreach(p IN LISTS arg_FILE_LIST)
        file(COPY_FILE "${p}" "${CURRENT_PACKAGES_DIR}/share/ffmpeg/copyright")
    endforeach()
endfunction()

