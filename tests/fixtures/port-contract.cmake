# Execute the entire generated Port. Only external vcpkg operations and
# the expensive FFmpeg subprocess are replaced by boundary test doubles.
# The real vcpkg pkg-config setup/restore helpers and real pkgconf are used.
cmake_minimum_required(VERSION 3.21)
set(PORT ffmpeg)
if(NOT TEST_ARCH)
    set(TEST_ARCH x64)
endif()
set(TARGET_TRIPLET "${TEST_ARCH}-windows")
set(VCPKG_TARGET_ARCHITECTURE "${TEST_ARCH}")
set(VCPKG_TARGET_IS_WINDOWS TRUE)
set(VCPKG_HOST_IS_WINDOWS ${CMAKE_HOST_WIN32})
set(VCPKG_TARGET_STATIC_LIBRARY_SUFFIX ".lib")
set(VCPKG_CONCURRENCY 2)
if(NOT DEFINED VCPKG_CRT_LINKAGE)
    set(VCPKG_CRT_LINKAGE static)
endif()
if(CMAKE_HOST_WIN32)
    set(VCPKG_HOST_PATH_SEPARATOR ";")
else()
    set(VCPKG_HOST_PATH_SEPARATOR ":")
endif()
set(CURRENT_PACKAGES_DIR "${FIXTURE}/sdk")
set(CURRENT_INSTALLED_DIR "${FIXTURE}/installed")
set(CURRENT_HOST_INSTALLED_DIR "${FIXTURE}/host")
set(CURRENT_BUILDTREES_DIR "${FIXTURE}/buildtrees")
if(NOT DEFINED TEST_FEATURES)
    set(TEST_FEATURES core avcodec avformat tesseract zmq)
endif()
set(FEATURES ${TEST_FEATURES})
if(STATIC_FIXTURE)
    list(APPEND FEATURES static)
endif()
file(MAKE_DIRECTORY "${CURRENT_BUILDTREES_DIR}")
set(VCPKG_DETECTED_MSVC TRUE)

function(vcpkg_from_github)
    set(SOURCE_PATH "${FIXTURE}/source" PARENT_SCOPE)
    file(APPEND "${FIXTURE}/events.txt" "source\n")
endfunction()

function(vcpkg_cmake_get_vars out)
    file(WRITE "${FIXTURE}/vars.cmake" [=[
set(VCPKG_DETECTED_MSVC TRUE)
set(VCPKG_COMBINED_C_FLAGS_RELEASE "-O2 -MT")
set(VCPKG_COMBINED_C_FLAGS_DEBUG "-Od -RTC1 -MTd")
set(VCPKG_COMBINED_SHARED_LINKER_FLAGS_RELEASE "-DEBUG")
set(VCPKG_COMBINED_SHARED_LINKER_FLAGS_DEBUG "-DEBUG")
]=])
    if(VCPKG_CRT_LINKAGE STREQUAL "dynamic")
        file(READ "${FIXTURE}/vars.cmake" vars)
        string(REPLACE "-MT" "-MD" vars "${vars}")
        file(WRITE "${FIXTURE}/vars.cmake" "${vars}")
    endif()
    set(${out} "${FIXTURE}/vars.cmake" PARENT_SCOPE)
endfunction()

function(vcpkg_find_acquire_program name)
    file(APPEND "${FIXTURE}/tools.txt" "${name}\n")
    set(${name} "${PKGCONF}" PARENT_SCOPE)
endfunction()
function(vcpkg_add_to_path)
    file(APPEND "${FIXTURE}/path-events.txt" "${ARGV}\n")
endfunction()
function(vcpkg_acquire_msys out)
    set(${out} "${FIXTURE}/msys" PARENT_SCOPE)
endfunction()
