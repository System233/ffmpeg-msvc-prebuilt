function(vcpkg_execute_required_process)
    cmake_parse_arguments(PARSE_ARGV 0 arg "" "WORKING_DIRECTORY;LOGNAME;OUTPUT_VARIABLE" "COMMAND;SAVE_LOG_FILES")
    if(arg_LOGNAME STREQUAL "automake-print-lib")
        set(${arg_OUTPUT_VARIABLE} "/usr/share/automake" PARENT_SCOPE)
        return()
    endif()
    if(arg_LOGNAME MATCHES "^libconvert-")
        # Record DEF -> LIB commands. A real lib.exe can be supplied to
        # verify that the generated archives have the correct machine.
        file(APPEND "${FIXTURE}/def-commands.txt" "${arg_COMMAND}\n")
        if(NATIVE_LIB)
            list(REMOVE_AT arg_COMMAND 0)
            execute_process(COMMAND "${NATIVE_LIB}" ${arg_COMMAND}
                WORKING_DIRECTORY "${arg_WORKING_DIRECTORY}" COMMAND_ERROR_IS_FATAL ANY)
        else()
            foreach(arg IN LISTS arg_COMMAND)
                if(arg MATCHES "^/out:(.+)$")
                    file(WRITE "${CMAKE_MATCH_1}" "fixture import archive")
                endif()
            endforeach()
        endif()
        return()
    endif()
    if(NOT arg_LOGNAME MATCHES "^build-${TARGET_TRIPLET}-(rel|dbg)$")
        message(FATAL_ERROR "Unexpected external command: ${arg_LOGNAME}")
    endif()
    set(cfg "${CMAKE_MATCH_1}")
    file(APPEND "${FIXTURE}/events.txt" "${cfg}\n")
    # Record the external invocation rather than inspecting Port source.
    file(COPY_FILE "${arg_WORKING_DIRECTORY}/build.sh" "${FIXTURE}/${cfg}.sh")
    file(WRITE "${FIXTURE}/${cfg}.lib-env" "$ENV{LIB}")
    if(REAL_BASH)
        # Run the actual generated production shell, real GNU make, and a
        # minimal configure fixture. Failures must propagate from each stage.
        get_filename_component(shell_dir "${REAL_BASH}" DIRECTORY)
        set(saved_path "$ENV{PATH}")
        cmake_path(CONVERT "${shell_dir}" TO_NATIVE_PATH_LIST native_shell)
        set(ENV{PATH} "${native_shell}${VCPKG_HOST_PATH_SEPARATOR}${saved_path}")
        set(ENV{FIXTURE_FAIL_STAGE} "${SHELL_FAIL_STAGE}")
        execute_process(COMMAND "${REAL_BASH}" ./build.sh
            WORKING_DIRECTORY "${arg_WORKING_DIRECTORY}"
            RESULT_VARIABLE shell_rc OUTPUT_VARIABLE shell_out ERROR_VARIABLE shell_err)
        set(ENV{PATH} "${saved_path}")
        unset(ENV{FIXTURE_FAIL_STAGE})
        file(WRITE "${FIXTURE}/${cfg}.shell.log" "${shell_out}\n${shell_err}")
        if(NOT shell_rc EQUAL 0)
            message(FATAL_ERROR "Fixture native shell failed: ${cfg}: ${shell_out}\n${shell_err}")
        endif()
    endif()
    file(READ "${arg_WORKING_DIRECTORY}/cflags.rsp" cflags)
    file(WRITE "${FIXTURE}/${cfg}.rsp" "${cflags}")
    execute_process(COMMAND "${PKGCONF}" --libs third
        RESULT_VARIABLE rc OUTPUT_VARIABLE libs ERROR_VARIABLE err
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    file(WRITE "${FIXTURE}/${cfg}.pkgconf" "${rc}|${libs}")
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Fixture configure could not find third: ${err}")
    endif()
    if("${FAIL_STAGE}" STREQUAL "${cfg}")
        message(FATAL_ERROR "Fixture external build failure: ${cfg}")
    endif()
    set(prefix "${CURRENT_PACKAGES_DIR}")
    if(cfg STREQUAL "dbg")
        string(APPEND prefix "/debug")
    endif()
    # Independent fixture outputs. These are deliberately not derived from
    # the Port's expected install directories or feature flags.
    file(MAKE_DIRECTORY "${prefix}/lib/pkgconfig" "${prefix}/bin")
    if(NOT DEFINED FIXTURE_MODULES)
        set(FIXTURE_MODULES avutil avcodec avformat)
    endif()
    foreach(m IN LISTS FIXTURE_MODULES)
        file(MAKE_DIRECTORY "${prefix}/include/lib${m}")
        set(header "${m}.h")
        if(m STREQUAL "postproc")
            set(header "postprocess.h")
        endif()
        file(WRITE "${prefix}/include/lib${m}/${header}" "/* fixture */\n")
        if(NOT GENERATE_DEF OR STATIC_FIXTURE)
            file(WRITE "${prefix}/lib/${m}.lib" "fixture archive ${cfg}")
        endif()
        set(major 58)
        set(requires "libavutil")
        if(m STREQUAL "avutil")
            set(major 56)
            set(requires "")
        elseif(m STREQUAL "avformat")
            set(requires "libavcodec libavutil")
        endif()
        if(NOT STATIC_FIXTURE)
            file(WRITE "${prefix}/bin/${m}-${major}.dll" "fixture DLL ${cfg}")
            if(GENERATE_DEF)
                file(WRITE "${prefix}/lib/${m}-${major}.def"
                    "LIBRARY ${m}-${major}.dll\nEXPORTS\n    ${m}_version\n")
            endif()
        endif()
        if(REAL_FIXUP)
            set(private_libs "")
            if(m STREQUAL "avutil")
                set(private_libs "-lthird_${cfg}")
                if(PRIVATE_PACKAGE_REQUIRES)
                    # A private pkg-config package can itself have transitive
                    # dependencies. The DLL has already linked their objects.
                    set(requires "third >= 1.0")
                endif()
            endif()
            file(WRITE "${prefix}/lib/pkgconfig/lib${m}.pc"
                "prefix=${prefix}\nlibdir=\${prefix}/lib\nincludedir=\${prefix}/include\n"
                "Name: lib${m}\nDescription: fixture\nVersion: ${major}.1.0\n"
                "Requires.private: ${requires}\nLibs: -L\${libdir} -l${m}\n"
                "Libs.private: ${private_libs}\nCflags: -I\${includedir}\n")
        else()
            file(WRITE "${prefix}/lib/pkgconfig/lib${m}.pc"
                "Name: lib${m}\nDescription: fixture\nVersion: ${major}.1.0\nRequires: ${requires}\nLibs: -l${m}\n")
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${arg_WORKING_DIRECTORY}/libavutil")
    if(NOT FIXTURE_VERSION)
        set(FIXTURE_VERSION "4.4.8")
    endif()
    file(WRITE "${arg_WORKING_DIRECTORY}/libavutil/ffversion.h" "#define FFMPEG_VERSION \"${FIXTURE_VERSION}\"\n")
    set(_fixture_config "#define CONFIG_LIBTESSERACT 1\n#define CONFIG_LIBZMQ 1\n#define CONFIG_OPENSSL 1\n#define CONFIG_CUDA 1\n#define CONFIG_NVENC 1\n#define CONFIG_FFNVCODEC 1\n#define CONFIG_LIBFDK_AAC 1\n#define CONFIG_FFMPEG 1\n#define CONFIG_FFPROBE 1\n#define HAVE_W32THREADS 1\n#define HAVE_SDL2 1\n")
    if(NOT FIXTURE_SDL2_HAVE_ONLY)
        string(APPEND _fixture_config "#define CONFIG_SDL2 1\n")
    endif()
    if("${cfg}" STREQUAL "${MISSING_FEATURE_CONFIG}" AND MISSING_FEATURE_MACRO)
        string(REPLACE "#define ${MISSING_FEATURE_MACRO} 1" "#define ${MISSING_FEATURE_MACRO} 0" _fixture_config "${_fixture_config}")
    endif()
    file(WRITE "${arg_WORKING_DIRECTORY}/config.h" "${_fixture_config}")
    if(NOT FIXTURE_LICENSE)
        set(FIXTURE_LICENSE "LGPL version 3 or later")
    endif()
    set(license "${FIXTURE_LICENSE}")
    if(cfg STREQUAL "dbg" AND WRONG_DEBUG_LICENSE)
        set(license "GPL version 3 or later")
    endif()
    if(cfg STREQUAL "dbg" AND MISSING_DEBUG_FEATURE OR cfg STREQUAL "rel" AND MISSING_RELEASE_FEATURE)
        file(WRITE "${arg_WORKING_DIRECTORY}/config.h" "#define CONFIG_LIBTESSERACT 0\n#define CONFIG_LIBZMQ 1\n")
    endif()
    if(cfg STREQUAL "dbg" AND MISSING_DEBUG_LICENSE)
        file(WRITE "${CURRENT_BUILDTREES_DIR}/${arg_LOGNAME}-out.log" "No license evidence\n")
    else()
        file(WRITE "${CURRENT_BUILDTREES_DIR}/${arg_LOGNAME}-out.log" "License: ${license}\n")
    endif()
    foreach(tool ffmpeg ffprobe ffplay)
        if(tool IN_LIST FEATURES)
            file(WRITE "${prefix}/bin/${tool}.exe" "fixture executable ${cfg}")
        endif()
    endforeach()
    if(cfg STREQUAL "dbg" AND MISSING_DEBUG_DLL)
        file(REMOVE "${prefix}/bin/avcodec-58.dll")
    endif()
    if(cfg STREQUAL "dbg" AND MISSING_DEBUG_ARCHIVE)
        file(REMOVE "${prefix}/lib/avcodec.lib")
    endif()
endfunction()

