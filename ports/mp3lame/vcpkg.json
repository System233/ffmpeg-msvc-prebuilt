{
  "name": "mp3lame",
  "version": "3.100",
  "port-version": 18,
  "description": "LAME 3.100 MP3 encoding library built without the MPGLIB decoder.",
  "homepage": "https://lame.sourceforge.io",
  "license": "LGPL-2.0-only",
  "dependencies": [
    {
      "name": "vcpkg-make",
      "host": true,
      "platform": "!windows | mingw"
    },
    {
      "name": "vcpkg-msbuild",
      "host": true,
      "platform": "windows & !mingw"
    }
  ],
  "features": {
    "frontend": {
      "description": "Build the lame frontend",
      "dependencies": [
        {
          "name": "ncurses",
          "platform": "!windows | mingw"
        }
      ]
    }
  }
}
