# Generated for the installed FFmpeg package. No consumer-side pkgconf needed.
include(FindPackageHandleStandardArgs)

# Stage 1: Discover the installed SDK and select a coherent configuration.
if(_ffmpeg_config_mode)
  # Config discovery has already selected the package. Never redirect to an
  # unrelated SDK via a stale legacy FFMPEG_ROOT cache entry.
  get_filename_component(_ff_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
elseif(FFMPEG_ROOT)
  get_filename_component(_ff_root "${FFMPEG_ROOT}" REALPATH)
else()
  get_filename_component(_ff_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
endif()
set(FFMPEG_VERSION "@FFMPEG_VERSION@")
set(FFmpeg_VERSION "${FFMPEG_VERSION}")
set(FFMPEG_MODULES "@FFMPEG_MODULES@")
set(_ff_linkage "@VCPKG_LIBRARY_LINKAGE@")
@FFMPEG_MODULE_METADATA@

# Cache individual file discoveries, not the result of a particular
# find_package() request. Recheck existence on every invocation, and
# invalidate the cache if the SDK location or generated metadata changes.
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _ff_metadata_hash)
# Legacy callers may copy the Find module out of the SDK, but when the
# selected root has its own metadata it must describe the same package.
if(NOT _ffmpeg_config_mode AND FFMPEG_ROOT)
  set(_ff_root_metadata "${_ff_root}/share/ffmpeg/FindFFmpeg.cmake")
  if(EXISTS "${_ff_root_metadata}")
    file(SHA256 "${_ff_root_metadata}" _ff_root_hash)
    if(NOT _ff_root_hash STREQUAL _ff_metadata_hash)
      message(FATAL_ERROR "FFmpeg SDK metadata mismatch: FFMPEG_ROOT selects a different SDK")
    endif()
  endif()
endif()
set(_ff_identity "${_ff_root}|${_ff_metadata_hash}")
# Include discovered file names, not contents; this detects additions and
# removals of the Debug overlay and changes of the selected library name.
file(GLOB _ff_layout_files
    "${_ff_root}/lib/*" "${_ff_root}/debug/lib/*"
    "${_ff_root}/bin/*.dll" "${_ff_root}/debug/bin/*.dll")
string(SHA256 _ff_layout "${_ff_identity}|${_ff_layout_files}")
if(TARGET FFmpeg::FFmpeg)
  get_target_property(_ff_existing FFmpeg::FFmpeg FFMPEG_SDK_IDENTITY)
  if(NOT _ff_existing STREQUAL _ff_layout)
    message(FATAL_ERROR "FFmpeg targets already refer to a different SDK")
  endif()
endif()
if(NOT "${FFMPEG_LAYOUT_SIGNATURE}" STREQUAL "${_ff_layout}")
  get_cmake_property(_ff_cached CACHE_VARIABLES)
  foreach(_ff_var IN LISTS _ff_cached)
    if(_ff_var MATCHES "^FFMPEG_(lib|DEPENDENCY_|FOUND$|LIBRARIES$|LIBRARY_DIRS$|INCLUDE_DIRS$|_DISCOVERY_)")
      unset(${_ff_var} CACHE)
      unset(${_ff_var})
    endif()
  endforeach()
  set(FFMPEG_LAYOUT_SIGNATURE "${_ff_layout}" CACHE INTERNAL "FFmpeg SDK identity" FORCE)
endif()

function(_ffmpeg_find_library out module config)
  set(_names "${module}")
  set(_folder "${_ff_root}/lib")
  if(config STREQUAL "DEBUG")
    set(_names "${module}d;${module}")
    set(_folder "${_ff_root}/debug/lib")
  endif()
  # Only a file discovered inside the requested configuration is valid.
  set(_key "FFMPEG__DISCOVERY_${module}_${config}")
  if(DEFINED ${_key})
    get_filename_component(_cached_dir "${${_key}}" DIRECTORY)
    if(NOT EXISTS "${${_key}}" OR NOT _cached_dir STREQUAL _folder)
      unset(${_key} CACHE)
    endif()
  endif()
  find_library(${_key} NAMES ${_names} PATHS "${_folder}"
               NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  set(${out} "${${_key}}" PARENT_SCOPE)
endfunction()

# Build the full list independent of CMAKE_BUILD_TYPE, including on
# multi-config generators and a later switch of single-config build type.
function(_ffmpeg_select out release debug)
  if("${release}" STREQUAL "${debug}")
    set(${out} "${release}" PARENT_SCOPE)
    return()
  endif()
  set(_result "")
  foreach(_lib IN LISTS release)
    list(APPEND _result optimized "${_lib}")
  endforeach()
  foreach(_lib IN LISTS debug)
    list(APPEND _result debug "${_lib}")
  endforeach()
  set(${out} "${_result}" PARENT_SCOPE)
endfunction()

function(_ffmpeg_resolve_deps out missing config)
  set(_result "")
  set(_missing "")
  set(_folder "${_ff_root}/lib")
  if(config STREQUAL "DEBUG")
    set(_folder "${_ff_root}/debug/lib")
  endif()
  foreach(_item IN LISTS ARGN)
    if(_item MATCHES "^vcpkg-lib:(.+)$")
      set(_path "${_folder}/${CMAKE_MATCH_1}")
      if(NOT EXISTS "${_path}")
        list(APPEND _missing "${config} dependency ${_item}")
      else()
        list(APPEND _result "${_path}")
      endif()
    else()
      # System libraries remain linker names. Never turn a failed Debug
      # lookup into a global find_library() that can pick Release archives.
      list(APPEND _result "${_item}")
    endif()
  endforeach()
  set(${out} "${_result}" PARENT_SCOPE)
  set(${missing} "${_missing}" PARENT_SCOPE)
endfunction()

set(_ff_errors "")
set(_ff_debug_sdk TRUE)
set(_ff_debug_artifacts FALSE)
set(_ff_debug_missing "")
set(FFMPEG_INCLUDE_DIRS "")
set(FFMPEG_LIBRARY_DIRS "")
set(FFMPEG_LIBRARIES "")
foreach(_mod IN LISTS FFMPEG_MODULES)
  set(_v "FFMPEG_lib${_mod}")
  set(${_v}_VERSION "${_ff_${_mod}_VERSION}")
  set(${_v}_INCLUDE_DIRS "${_ff_root}/include")
  set(${_v}_FOUND TRUE)
  _ffmpeg_find_library(${_v}_LIBRARY_RELEASE "${_mod}" RELEASE)
  _ffmpeg_find_library(${_v}_LIBRARY_DEBUG "${_mod}" DEBUG)
  if(NOT EXISTS "${_ff_root}/include/lib${_mod}/${_ff_${_mod}_HEADER}"
     OR NOT ${_v}_LIBRARY_RELEASE)
    list(APPEND _ff_errors "${_mod}: missing Release library or header")
    set(${_v}_FOUND FALSE)
  endif()
  if(_ff_linkage STREQUAL "dynamic" AND WIN32)
    string(REGEX MATCH "^[0-9]+" _major "${${_v}_VERSION}")
    set(${_v}_DLL_RELEASE "${_ff_root}/bin/${_mod}-${_major}.dll")
    set(${_v}_DLL_DEBUG "${_ff_root}/debug/bin/${_mod}-${_major}.dll")
    if(NOT EXISTS "${${_v}_DLL_RELEASE}")
      list(APPEND _ff_errors "${_mod}: missing Release DLL")
      set(${_v}_FOUND FALSE)
    endif()
    if(${_v}_LIBRARY_DEBUG OR EXISTS "${${_v}_DLL_DEBUG}")
      set(_ff_debug_artifacts TRUE)
    endif()
    if(NOT ${_v}_LIBRARY_DEBUG OR NOT EXISTS "${${_v}_DLL_DEBUG}")
      set(_ff_debug_sdk FALSE)
      list(APPEND _ff_debug_missing "${_mod}: missing Debug library or DLL")
    endif()
  elseif(NOT ${_v}_LIBRARY_DEBUG)
    list(APPEND _ff_errors "${_mod}: missing Debug library")
    set(${_v}_FOUND FALSE)
  endif()
endforeach()

# Resolve dependency lists before deciding whether the shared Debug overlay
# is complete. This keeps all modules and external archives in one SDK
# configuration. Static native Ports still require both configurations.
foreach(_mod IN LISTS FFMPEG_MODULES)
  set(_v "FFMPEG_lib${_mod}")
  _ffmpeg_resolve_deps(${_v}_DEPS_LIBRARY_RELEASE _missing RELEASE ${_ff_${_mod}_RELEASE})
  if(_missing)
    list(APPEND _ff_errors ${_missing})
    set(${_v}_FOUND FALSE)
  endif()
  _ffmpeg_resolve_deps(${_v}_DEPS_LIBRARY_DEBUG _missing DEBUG ${_ff_${_mod}_DEBUG})
  if(_missing)
    if(_ff_linkage STREQUAL "dynamic" AND WIN32)
      set(_ff_debug_sdk FALSE)
      list(APPEND _ff_debug_missing ${_missing})
    else()
      list(APPEND _ff_errors ${_missing})
      set(${_v}_FOUND FALSE)
    endif()
  endif()
endforeach()

# Use the same configuration semantics as CMake's legacy debug/optimized
# keywords. CMake runtime-library settings belong to the consumer and are
# deliberately not consulted or changed by this package.
get_property(_ff_debug_configs GLOBAL PROPERTY DEBUG_CONFIGURATIONS)
if(NOT _ff_debug_configs)
  set(_ff_debug_configs Debug)
endif()
list(TRANSFORM _ff_debug_configs TOUPPER)
set(_ff_report_configs "${CMAKE_CONFIGURATION_TYPES}")
if(NOT _ff_report_configs)
  set(_ff_report_configs "${CMAKE_BUILD_TYPE}")
endif()
set(_ff_mapping_configs Release Debug RelWithDebInfo MinSizeRel ${_ff_report_configs} ${_ff_debug_configs})
list(TRANSFORM _ff_mapping_configs TOUPPER)
list(REMOVE_DUPLICATES _ff_mapping_configs)
foreach(_cfg IN LISTS _ff_mapping_configs)
  if(_cfg IN_LIST _ff_debug_configs)
    set(_ff_map_${_cfg} DEBUG)
  else()
    set(_ff_map_${_cfg} RELEASE)
  endif()
  # A consumer may set a CMake imported-configuration override. The raw
  # legacy link list cannot represent an override conflicting with CMake's
  # global debug/optimized semantics, so reject that conflict explicitly.
  if(DEFINED CMAKE_MAP_IMPORTED_CONFIG_${_cfg})
    set(_ff_requested_map "")
    foreach(_candidate IN LISTS CMAKE_MAP_IMPORTED_CONFIG_${_cfg})
      string(TOUPPER "${_candidate}" _candidate)
      if(_candidate STREQUAL "DEBUG" OR _candidate STREQUAL "RELEASE")
        set(_ff_requested_map "${_candidate}")
        break()
      elseif(_candidate STREQUAL "")
        set(_ff_requested_map RELEASE)
        break()
      endif()
    endforeach()
    if("${CMAKE_MAP_IMPORTED_CONFIG_${_cfg}}" STREQUAL "")
      set(_ff_requested_map RELEASE)
    endif()
    if(NOT _ff_requested_map STREQUAL _ff_map_${_cfg})
      list(APPEND _ff_errors "configuration ${_cfg}: incompatible CMAKE_MAP_IMPORTED_CONFIG_${_cfg} with DEBUG_CONFIGURATIONS")
    endif()
  endif()
endforeach()

# Unlike $<CONFIG:...>, this expression compares the actual consumer
# configuration name without imported-target alias matching.
set(_ff_debug_terms "")
foreach(_cfg IN LISTS _ff_debug_configs)
  list(APPEND _ff_debug_terms "$<STREQUAL:$<UPPER_CASE:$<CONFIG>>,${_cfg}>")
endforeach()
list(JOIN _ff_debug_terms "," _ff_debug_terms)
set(_ff_is_debug "$<OR:${_ff_debug_terms}>")

foreach(_mod IN LISTS FFMPEG_MODULES)
  set(_v "FFMPEG_lib${_mod}")
  if(_ff_linkage STREQUAL "dynamic" AND WIN32 AND NOT _ff_debug_sdk)
    set(${_v}_LIBRARY_DEBUG "${${_v}_LIBRARY_RELEASE}")
    set(${_v}_DLL_DEBUG "${${_v}_DLL_RELEASE}")
    set(${_v}_DEPS_LIBRARY_DEBUG "${${_v}_DEPS_LIBRARY_RELEASE}")
  endif()
  foreach(_dep IN LISTS _ff_${_mod}_DEPS)
    if(NOT _dep IN_LIST FFMPEG_MODULES OR NOT FFMPEG_lib${_dep}_FOUND)
      list(APPEND _ff_errors "${_mod}: missing internal dependency ${_dep}")
      set(${_v}_FOUND FALSE)
    endif()
  endforeach()
  _ffmpeg_select(${_v}_LIBRARY "${${_v}_LIBRARY_RELEASE}" "${${_v}_LIBRARY_DEBUG}")
  _ffmpeg_select(${_v}_DEPS_LIBRARY "${${_v}_DEPS_LIBRARY_RELEASE}" "${${_v}_DEPS_LIBRARY_DEBUG}")
  get_filename_component(${_v}_LIBRARY_RELEASE_DIR "${${_v}_LIBRARY_RELEASE}" DIRECTORY)
  get_filename_component(${_v}_LIBRARY_DEBUG_DIR "${${_v}_LIBRARY_DEBUG}" DIRECTORY)
  set(FFmpeg_${_mod}_FOUND "${${_v}_FOUND}")
  set(FFMPEG_${_mod}_FOUND "${${_v}_FOUND}")
  if(${_v}_FOUND)
    list(APPEND FFMPEG_INCLUDE_DIRS "${${_v}_INCLUDE_DIRS}")
    list(APPEND FFMPEG_LIBRARY_DIRS "${${_v}_LIBRARY_RELEASE_DIR}" "${${_v}_LIBRARY_DEBUG_DIR}")
  endif()
endforeach()
list(REMOVE_DUPLICATES FFMPEG_INCLUDE_DIRS)
list(REMOVE_DUPLICATES FFMPEG_LIBRARY_DIRS)
# Metadata is ordered dependency-first; Legacy link line is dependent-first.
set(_ff_link_order "${FFMPEG_MODULES}")
list(REVERSE _ff_link_order)
foreach(_mod IN LISTS _ff_link_order)
  list(APPEND FFMPEG_LIBRARIES ${FFMPEG_lib${_mod}_LIBRARY})
endforeach()
foreach(_mod IN LISTS _ff_link_order)
  list(APPEND FFMPEG_LIBRARIES ${FFMPEG_lib${_mod}_DEPS_LIBRARY})
endforeach()
set(FFMPEG_LIBRARY "${FFMPEG_LIBRARIES}")
set(_ff_complete TRUE)
if(_ff_errors OR NOT FFMPEG_libavutil_FOUND)
  set(_ff_complete FALSE)
endif()
string(JOIN ", " _ff_reason ${_ff_errors})

# Stage 2: Report each request separately (version, required/optional
# components, quiet/required flags, and legacy variables).
foreach(_component IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
  if(NOT _component IN_LIST FFMPEG_MODULES)
    set(FFmpeg_${_component}_FOUND FALSE)
    set(FFMPEG_${_component}_FOUND FALSE)
  endif()
endforeach()
find_package_handle_standard_args(${CMAKE_FIND_PACKAGE_NAME}
    REQUIRED_VARS _ff_complete FFMPEG_LIBRARIES FFMPEG_LIBRARY_DIRS FFMPEG_INCLUDE_DIRS
    VERSION_VAR FFMPEG_VERSION HANDLE_COMPONENTS HANDLE_VERSION_RANGE
    REASON_FAILURE_MESSAGE "${_ff_reason}")
set(FFMPEG_FOUND "${${CMAKE_FIND_PACKAGE_NAME}_FOUND}")
set(FFmpeg_FOUND "${FFMPEG_FOUND}")
set(z_vcpkg_using_vcpkg_find_ffmpeg "${FFMPEG_FOUND}")

# Stage 3: Create globally visible targets after a successful request.
if(FFmpeg_FOUND AND NOT TARGET FFmpeg::FFmpeg)
  add_library(FFmpeg::FFmpeg INTERFACE IMPORTED GLOBAL)
  set_target_properties(FFmpeg::FFmpeg PROPERTIES
    FFMPEG_SDK_IDENTITY "${_ff_layout}"
    INTERFACE_INCLUDE_DIRECTORIES "${FFMPEG_INCLUDE_DIRS}")
  add_library(FFMPEG::ffmpeg ALIAS FFmpeg::FFmpeg)
  foreach(_mod IN LISTS FFMPEG_MODULES)
    set(_v "FFMPEG_lib${_mod}")
    if(_ff_linkage STREQUAL "dynamic")
      add_library(FFmpeg::${_mod} SHARED IMPORTED GLOBAL)
    else()
      add_library(FFmpeg::${_mod} STATIC IMPORTED GLOBAL)
    endif()
    set(_release "${${_v}_LIBRARY_RELEASE}")
    set(_debug "${${_v}_LIBRARY_DEBUG}")
    if(_ff_linkage STREQUAL "dynamic" AND WIN32)
      set_target_properties(FFmpeg::${_mod} PROPERTIES
        IMPORTED_IMPLIB "${_release}"
        IMPORTED_IMPLIB_RELEASE "${_release}"
        IMPORTED_IMPLIB_DEBUG "${_debug}")
      set(_release "${${_v}_DLL_RELEASE}")
      set(_debug "${${_v}_DLL_DEBUG}")
    endif()
    set_target_properties(FFmpeg::${_mod} PROPERTIES
      IMPORTED_CONFIGURATIONS "RELEASE;DEBUG"
      IMPORTED_LOCATION "${_release}"
      IMPORTED_LOCATION_RELEASE "${_release}"
      IMPORTED_LOCATION_DEBUG "${_debug}"
      INTERFACE_INCLUDE_DIRECTORIES "${${_v}_INCLUDE_DIRS}")
    foreach(_cfg IN LISTS _ff_mapping_configs)
      set_property(TARGET FFmpeg::${_mod} PROPERTY MAP_IMPORTED_CONFIG_${_cfg} "${_ff_map_${_cfg}}")
    endforeach()
    add_library(FFMPEG::${_mod} ALIAS FFmpeg::${_mod})
    if("${${_v}_DEPS_LIBRARY_RELEASE}" STREQUAL "${${_v}_DEPS_LIBRARY_DEBUG}")
      target_link_libraries(FFmpeg::${_mod} INTERFACE ${${_v}_DEPS_LIBRARY_RELEASE})
    else()
      foreach(_lib IN LISTS ${_v}_DEPS_LIBRARY_RELEASE)
        target_link_libraries(FFmpeg::${_mod} INTERFACE "$<$<NOT:${_ff_is_debug}>:${_lib}>")
      endforeach()
      foreach(_lib IN LISTS ${_v}_DEPS_LIBRARY_DEBUG)
        target_link_libraries(FFmpeg::${_mod} INTERFACE "$<${_ff_is_debug}:${_lib}>")
      endforeach()
    endif()
    target_link_libraries(FFmpeg::FFmpeg INTERFACE FFmpeg::${_mod})
  endforeach()
  foreach(_mod IN LISTS FFMPEG_MODULES)
    foreach(_dep IN LISTS _ff_${_mod}_DEPS)
      target_link_libraries(FFmpeg::${_mod} INTERFACE FFmpeg::${_dep})
    endforeach()
  endforeach()
endif()

# Report actual SDK selection once per configuration and SDK identity.
# A missing optional overlay is normal; an incomplete one deserves a
# diagnostic but still uses the complete Release SDK.
if(FFmpeg_FOUND AND NOT ${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY)
  if(_ff_linkage STREQUAL "dynamic" AND WIN32 AND NOT _ff_debug_sdk AND _ff_debug_artifacts)
    get_property(_ff_warned GLOBAL PROPERTY "_FFmpeg_partial_${_ff_layout}")
    if(NOT _ff_warned)
      string(JOIN ", " _ff_debug_reason ${_ff_debug_missing})
      message(STATUS "FFmpeg: incomplete Debug SDK; using Release SDK (${_ff_debug_reason})")
      set_property(GLOBAL PROPERTY "_FFmpeg_partial_${_ff_layout}" TRUE)
    endif()
  endif()
  if(NOT _ff_report_configs)
    set(_ff_report_configs "<default>")
  endif()
  foreach(_cfg IN LISTS _ff_report_configs)
    string(TOUPPER "${_cfg}" _uc)
    set(_selected Release)
    set(_suffix "")
    if(_uc IN_LIST _ff_debug_configs)
      if(_ff_debug_sdk)
        set(_selected Debug)
      elseif(_ff_debug_artifacts)
        set(_suffix " (incomplete Debug SDK)")
      else()
        set(_suffix " (Debug SDK not installed)")
      endif()
    endif()
    string(SHA256 _ff_report_key "${_ff_layout}|${_uc}|${_selected}")
    get_property(_ff_reported GLOBAL PROPERTY "_FFmpeg_reported_${_ff_report_key}")
    if(NOT _ff_reported)
      message(STATUS "FFmpeg ${FFMPEG_VERSION}: ${_cfg} -> ${_selected}${_suffix}")
      set_property(GLOBAL PROPERTY "_FFmpeg_reported_${_ff_report_key}" TRUE)
    endif()
  endforeach()
endif()
