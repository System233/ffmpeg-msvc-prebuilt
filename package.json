{
  "name": "ffmpeg-msvc-prebuilt-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepareData": "tsx scripts/prepare-data.ts",
    "dev": "pnpm prepareData && react-router dev",
    "build": "pnpm prepareData && react-router build && tsx scripts/finalize.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --outDir build/client",
    "test:e2e": "playwright test",
    "format": "prettier --write app scripts tests *.ts",
    "format:check": "prettier --check app scripts tests *.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-router/node": "^7.9.0",
    "highlight.js": "^11.12.0",
    "isbot": "^5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.56.0",
    "@react-router/dev": "^7.9.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
